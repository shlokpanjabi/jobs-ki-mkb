# Required. Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. If set, the board UI asks for this password (HTTP Basic auth, any username).
# /api/jobs is not affected; it always uses per-user API keys.
BOARD_PASSWORD=

# Optional. IANA timezone used to decide what "today" is for deadlines. Defaults to UTC.
APP_TIMEZONE=America/New_York

# Job ingestion (npm run ingest and the /api/cron/ingest cron route).
# API key(s) from `npm run keys`; each ingested job becomes eligible for each key's owner.
# Comma-separate several keys to share jobs with several people.
INGEST_API_KEY=
# Where scripts/ingest.mjs posts jobs. The cron route defaults to its own deployment.
INGEST_BASE_URL=http://localhost:3000
# Optional. Comma-separated subset of: gradcracker, indeed-uk, luma. Defaults to all.
INGEST_SOURCES=
# Required for /api/cron/ingest. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
