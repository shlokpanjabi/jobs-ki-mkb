# Required. Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. If set, the board UI asks for this password (HTTP Basic auth, any username).
# /api/jobs is not affected; it always uses per-user API keys.
BOARD_PASSWORD=

# Optional. IANA timezone used to decide what "today" is for deadlines. Defaults to UTC.
APP_TIMEZONE=America/New_York

# Job ingestion (npm run ingest and the /api/cron/ingest cron route). Writes with DATABASE_URL.
# Optional. Comma-separated user ids who see ingested jobs. Defaults to every user.
INGEST_USERS=
# Optional. Per-person rules as JSON (see README "Who sees what"), e.g.
# {"alex":{"started":2025,"courseYears":3,"grade":68,"hideRegions":["Canada"]}}
INGEST_PROFILES=
# Optional. Comma-separated subset of: sheets, gradcracker, bright-network, prosple-uk,
# northwestern-quant, simplify, speedyapply, indeed-uk, internshala, luma. Defaults to all.
INGEST_SOURCES=
# Optional. Comma-separated CSV or Google Sheets URLs (shared "anyone with the link can view").
INGEST_SHEETS=
# Email status sync (/api/inbound-email). See README "Email status sync".
RESEND_WEBHOOK_SECRET=
RESEND_API_KEY=
# Optional: Claude fallback for emails the rules can't classify.
ANTHROPIC_API_KEY=
# Optional: 1 = classify and match without writing.
INBOUND_DRY_RUN=
# Optional: defaults to uestuuchue.resend.app.
INBOUND_EMAIL_DOMAIN=

# Required for /api/cron/ingest. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
