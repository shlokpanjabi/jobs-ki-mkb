# Required. Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. If set, the board UI asks for this password (HTTP Basic auth, any username).
# /api/jobs is not affected; it always uses per-user API keys.
BOARD_PASSWORD=

# Optional. IANA timezone used to decide what "today" is for deadlines. Defaults to UTC.
APP_TIMEZONE=America/New_York

# Job ingestion (npm run ingest and the /api/cron/ingest cron route). Writes with DATABASE_URL.
# Optional. Comma-separated user ids who see ingested jobs. Defaults to every user.
INGEST_USERS=
# Optional. Comma-separated subset of: gradcracker, indeed-uk, luma. Defaults to all.
INGEST_SOURCES=
# Required for /api/cron/ingest. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
